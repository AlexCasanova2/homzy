PORT=5177
# Cadena de conexión Postgres (Supabase → Project Settings → Database → Connection string → Transaction pooler, puerto 6543)
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
AMAZON_STORE_ID=your-amazon-associates-tag
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_REFERRER=
LLM_APP_NAME=

# Google Search Console (sección /admin/search-console). Cuenta de servicio de Google Cloud
# con la Search Console API activada, añadida además como usuario Propietario de la propiedad
# en Search Console → Configuración → Usuarios y permisos (el acceso no se hereda de Cloud).
# La clave privada va entre comillas y con los saltos de línea escapados como \n.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# Propiedad exacta: "sc-domain:homzy.es" (propiedad de dominio) o "https://homzy.es/" (prefijo de URL)
GSC_SITE_URL=
